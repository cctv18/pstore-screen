+						 size_t *required_len)
+{
+	struct printk_info read_info;
+	struct printk_info size_info;
+	unsigned int line_count;
+	struct printk_record record;
+
+	if (!buf || !formatted_len || !required_len ||
+	    capacity < PSTORE_SCREEN_MAX_FORMATTED_RECORD_BYTES + 1U)
+		return -EINVAL;
+	if (!prb_read_valid_info(prb, seq, &size_info, &line_count) ||
+	    size_info.seq != seq)
+		return -ENOENT;
+	*required_len = get_record_print_text_size(&size_info, line_count,
+							true, printk_time);
+	prb_rec_init_rd(&record, &read_info, buf, capacity);
+	if (!prb_read_valid(prb, seq, &record) || read_info.seq != seq)
+		return -ESTALE;
+	*formatted_len = record_print_text(&record, true, printk_time);
+	return 0;
