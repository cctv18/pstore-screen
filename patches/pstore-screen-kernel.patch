+	struct printk_info read_info;
+	struct printk_info size_info;
+	unsigned int line_count;
+	struct printk_record record;
+
+	if (!buf || !formatted_len || !required_len ||
+	    capacity < PSTORE_SCREEN_MAX_FORMATTED_RECORD_BYTES + 1U)
